{
  "name": "@pelada/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.sw.json",
    "lint:css": "stylelint \"src/**/*.css\"",
    "e2e": "playwright test -c e2e/playwright.config.ts --pass-with-no-tests",
    "visual": "node e2e/visual.mjs",
    "e2e:integracao": "playwright test -c e2e/integracao/playwright.config.ts"
  },
  "dependencies": {
    "@pelada/contrato": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "pdfjs-dist": "^6.4.299",
    "stylelint": "^17.16.0",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  }
}
