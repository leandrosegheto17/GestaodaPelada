# Recursos desligados no build, separados por vírgula. Valores válidos: simulador, pdf, financeiro, privacidade
VITE_RECURSOS_DESLIGADOS=
# Só no Docker: endereço da API para o proxy de /api do Vite (vazio = sem proxy)
ALVO_API_DEV=
# Só no Docker/Windows: true liga o polling do Vite (a montagem não propaga eventos de arquivo)
CHOKIDAR_USEPOLLING=
