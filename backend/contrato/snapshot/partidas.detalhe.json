{
  "direcao": "resposta",
  "esquema": {
    "additionalProperties": false,
    "properties": {
      "alteradaEm": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "type": "string"
      },
      "alteradaPor": {
        "type": "string"
      },
      "choveu": {
        "type": "boolean"
      },
      "data": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "hoje": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "jogadores": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "apelido": {
              "type": "string"
            },
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "situacao": {
              "enum": ["ausente", "presente", "lesionado", "expulso"],
              "type": "string"
            }
          },
          "required": ["id", "apelido", "situacao"],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": ["data", "hoje", "choveu", "alteradaPor", "alteradaEm", "jogadores"],
    "type": "object"
  }
}
