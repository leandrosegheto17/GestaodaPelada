{
  "direcao": "resposta",
  "esquema": {
    "additionalProperties": false,
    "properties": {
      "erro": {
        "additionalProperties": false,
        "properties": {
          "campos": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "codigo": {
            "const": "partida_ja_existe",
            "type": "string"
          },
          "dataExistente": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "mensagem": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["codigo", "mensagem", "dataExistente"],
        "type": "object"
      }
    },
    "required": ["erro"],
    "type": "object"
  }
}
