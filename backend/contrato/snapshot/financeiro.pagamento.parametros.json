{
  "direcao": "entrada",
  "esquema": {
    "additionalProperties": false,
    "properties": {
      "jogadorId": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "mes": {
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
        "type": "string"
      }
    },
    "required": ["jogadorId", "mes"],
    "type": "object"
  }
}
