{
  "direcao": "resposta",
  "esquema": {
    "additionalProperties": false,
    "properties": {
      "erro": {
        "additionalProperties": {},
        "properties": {
          "campos": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "codigo": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "mensagem": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["codigo", "mensagem"],
        "type": "object"
      }
    },
    "required": ["erro"],
    "type": "object"
  }
}
