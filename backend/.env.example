# Endereço público completo do app (sem barra final). Ex.: https://<subdominio>.workers.dev
URL_PUBLICA=
# Endereço novo, quando o app mudar de domínio (opcional). Mesmo formato de URL_PUBLICA
ENDERECO_NOVO=
# E-mail da conta do dono (usado só por backend/scripts/dono.ts)
DONO_EMAIL=
# Conexão direta com o Postgres, usada por backend/scripts (migrar, dono, seed). Host remoto exige --alvo
DATABASE_URL=
# Postgres descartável dos testes da API (host local; a trava de host confere)
DATABASE_URL_TESTE=
