{
  "name": "gestao-da-pelada",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint . && pnpm -r --if-present lint:css",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p backend/scripts",
    "test": "pnpm -r test",
    "test:checagens": "vitest run backend/scripts --testTimeout=30000",
    "migrar": "tsx backend/scripts/migrar.ts",
    "seed": "tsx backend/scripts/seed-local.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@pelada/contrato": "workspace:*",
    "@pelada/dominio": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.23.0"
}
